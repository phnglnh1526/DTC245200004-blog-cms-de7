      "id": 1,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "pluginVersion": "13.2.2",
      "datasource": {
        "type": "prometheus",
        "uid": "fg20su56ob8jka"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\",name=~\"blog-cms.*\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "fg20su56ob8jka"
          },
          "editorMode": "code",
          "legendFormat": "{{name}}",
          "range": true,
          "instant": false,
          "hide": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
